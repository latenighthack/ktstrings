{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/latenighthack/ktstrings/schema/catalog-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "namespace",
    "sourceLocale",
    "messages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "sourceLocale": {
      "type": "string"
    },
    "messages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "arguments": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "enum": [
                "string",
                "int"
              ]
            }
          },
          "body": {
            "$ref": "#/$defs/body"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "body": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "plural",
            "cases"
          ],
          "properties": {
            "plural": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "cases": {
              "type": "object",
              "required": [
                "other"
              ],
              "propertyNames": {
                "enum": [
                  "zero",
                  "one",
                  "two",
                  "few",
                  "many",
                  "other"
                ]
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
